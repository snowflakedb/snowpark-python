df4 = df.select(try_to_timestamp("A"), try_to_timestamp_ltz("A", "YYYY-MM-DD"), try_to_timestamp_ntz(col("A")), try_to_timestamp_tz("A", col("B")))

df5 = df.select(try_to_double("A"), try_to_double("A", "999.99MI"), try_to_decfloat(col("A")), try_to_decfloat("A", "999.99"))

df6 = df.select(try_to_decimal("A"), try_to_decimal("A", 10), try_to_decimal("A", 10, 2), try_to_decimal("A", None, 2), try_to_decimal("A", None, None, "$99.99"), try_to_decimal(col("A"), 10, 2, col("B")))

df7 = df.select(try_to_decimal("A", 10, 2), try_to_decimal("A", None, None, "99.9"))

