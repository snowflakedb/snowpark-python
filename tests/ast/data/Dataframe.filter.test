## TEST CASE

df1 = session.table(tables.table1)

df2 = df1.filter((col("A") > 1) & (col("B") < 100))

df3 = df1.filter(col("a") > 1)

df4 = df1.filter("a > 1 and b < 100")

df5 = df1.filter("a > 1")

from snowflake.snowpark.window import Window

df6 = df1.filter(row_number().over(Window.order_by("NUM")) == 1)

df7 = df1.where(row_number().over(Window.order_by("NUM")) == 1)

df8 = df1.filter((col("NUM") > 1) & (row_number().over(Window.order_by("NUM")) == 1))

df9 = df1.where((col("NUM") > 1) & (row_number().over(Window.order_by("NUM")) == 1))

