## TEST CASE

df = session.table(tables.table1)

df1 = df.select(to_timestamp("A"), to_timestamp("A", "YYYY-MM-DD"), to_timestamp("A", 9), to_timestamp(col("A"), col("B")))

df2 = df.select(to_char("A"), to_char("A", "YYYY-MM-DD"), to_char(col("A"), col("B")), to_varchar("A", col("B")))

df3 = df.select(to_binary("A"), to_binary("A", "HEX"), to_binary(col("A"), col("B")))

df4 = df.select(try_to_binary("A"), try_to_binary("A", "HEX"), try_to_binary(col("A"), col("B")))

