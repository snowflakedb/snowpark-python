## TEST CASE

df1 = session.table(tables.table1)

from snowflake.snowpark.window import Window

df2 = df1.qualify(row_number().over(Window.partition_by("STR").order_by(col("NUM").desc())) == 1)

df3 = df1.qualify("row_number() over (partition by str order by num desc) = 1")

df4 = df1.filter(col("NUM") > 1).qualify((col("NUM") < 10) & (row_number().over(Window.order_by("NUM")) == 1))

